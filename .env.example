# MeetAgent Configuration Example
# Copy this file to .env and configure your local settings.
# NEVER commit your real .env with API keys to Git!

# Server binding
MEET_AGENT_HOST=127.0.0.1
MEET_AGENT_PORT=8765

# Agent Brain (auto / agy-stream / agy-acp / opencode-acp / claude-cli / demo)
MEET_AGENT_DEFAULT_BRAIN=auto
MEET_AGENT_NAME="MeetAgent · AI参会助手"
MEET_AGENT_WAKE_WORDS="小会,MeetAgent,Antigravity,助手,Agent"

# Audio & Virtual Microphone routing
MEET_AGENT_AUDIO_OUTPUT_HINT="CABLE Input"
MEET_AGENT_ENABLE_TTS=true
MEET_AGENT_TTS_PROVIDER=edge-tts
MEET_AGENT_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ASR Transcription
# Options: agy-multimodal (zero-cost native AI reading), dashscope (Qwen ASR), faster-whisper, openai-compatible
MEET_AGENT_ASR_PROVIDER=agy-multimodal
MEET_AGENT_DASHSCOPE_API_KEY=your_dashscope_api_key_here
MEET_AGENT_DASHSCOPE_ASR_MODEL=qwen3-asr-flash

# Privacy & Decision Guardrail
MEET_AGENT_SAVE_RAW_AUDIO=false
MEET_AGENT_DECISION_MIN_CONFIDENCE=0.75
MEET_AGENT_AUTO_SEND_JOIN_NOTICE=true
